{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkSpacesPersonalPoolsCoreReadOnly",
      "Effect": "Allow",
      "Action": [
        "workspaces:DescribeWorkspaces",
        "workspaces:DescribeWorkspacesConnectionStatus",
        "workspaces:DescribeWorkspaceDirectories",
        "workspaces:DescribeWorkspaceBundles",
        "workspaces:DescribeWorkspacesPools",
        "workspaces:DescribeWorkspacesPoolSessions",
        "workspaces:DescribeTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesApplicationsReadOnly",
      "Effect": "Allow",
      "Action": [
        "appstream:DescribeFleets",
        "appstream:DescribeStacks",
        "appstream:ListAssociatedFleets",
        "appstream:ListAssociatedStacks",
        "appstream:DescribeSessions",
        "appstream:DescribeImages",
        "appstream:DescribeImageBuilders"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesSecureBrowserReadOnly",
      "Effect": "Allow",
      "Action": [
        "workspaces-web:ListPortals",
        "workspaces-web:GetPortal",
        "workspaces-web:ListBrowserSettings",
        "workspaces-web:ListUserSettings",
        "workspaces-web:ListNetworkSettings",
        "workspaces-web:GetUserSettings",
        "workspaces-web:GetNetworkSettings",
        "workspaces-web:GetDataProtectionSettings",
        "workspaces-web:ListSessions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesCoreManagedInstancesReadOnly",
      "Effect": "Allow",
      "Action": [
        "workspaces-instances:ListWorkspaceInstances",
        "workspaces-instances:GetWorkspaceInstance",
        "workspaces-instances:ListInstanceTypes",
        "workspaces-instances:ListRegions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SharedDependenciesReadOnly",
      "Effect": "Allow",
      "Action": [
        "ds:DescribeDirectories",
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics",
        "application-autoscaling:DescribeScalingActivities",
        "ec2:DescribeInstances",
        "cloudtrail:LookupEvents",
        "servicequotas:ListServiceQuotas",
        "servicequotas:GetServiceQuota"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CostAndPricingReadOnly",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetDimensionValues",
        "pricing:GetProducts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesPersonalLifecycleWrite",
      "Effect": "Allow",
      "Action": [
        "workspaces:StartWorkspaces",
        "workspaces:StopWorkspaces",
        "workspaces:RebootWorkspaces",
        "workspaces:ModifyWorkspaceProperties"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesPoolsLifecycleWrite",
      "Effect": "Allow",
      "Action": [
        "workspaces:StartWorkspacesPool",
        "workspaces:StopWorkspacesPool",
        "workspaces:UpdateWorkspacesPool"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkSpacesApplicationsLifecycleWrite",
      "Effect": "Allow",
      "Action": [
        "appstream:StartFleet",
        "appstream:StopFleet",
        "appstream:UpdateFleet"
      ],
      "Resource": "*"
    }
  ]
}
